# Traceon server configuration. Copy to .env and fill in.
# Never commit .env — it contains your GitHub client secret.

# Public URL of this Traceon server (no trailing slash).
# GitHub's callback URL must be: ${APP_URL}/auth/github/callback
APP_URL=http://localhost:3000
PORT=3000

# GitHub sign-in mode:
#   app   = GitHub App with user authorization (recommended: fine-grained, read-only)
#   oauth = classic GitHub OAuth App
GITHUB_AUTH_MODE=app

# From your GitHub App / OAuth App settings page (server-side only).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App only: the app's URL slug (github.com/apps/<slug>). Used for the
# "choose which repositories Traceon can read" link.
GITHUB_APP_SLUG=

# OAuth App only. Default "read:user" gives read-only access to public repositories.
# Private repositories need "repo", which GitHub does not offer as read-only —
# prefer GITHUB_AUTH_MODE=app for private repositories.
# GITHUB_OAUTH_SCOPES=read:user

# Optional tuning
# SESSION_TTL_HOURS=8
# SCAN_MAX_ARCHIVE_MB=80
# SCAN_MAX_FILES=4000

# GitHub Enterprise Server only
# GITHUB_WEB_BASE=https://github.example.com
# GITHUB_API_BASE=https://github.example.com/api/v3
